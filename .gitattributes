# Normalize cross-platform source and documentation in the repository.
* text=auto eol=lf

# PowerShell and project source.
*.ps1 text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sql text eol=lf

# Documentation and configuration.
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows command scripts require Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Bundled managed and native runtime assets must never be transformed.
*.dll binary !eol
*.dylib binary !eol
*.so binary !eol
*.pdb binary !eol
*.nupkg binary !eol
*.zip binary !eol
*.sqlite binary !eol
*.png binary !eol
